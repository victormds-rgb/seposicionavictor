# ══════════════════════════════════════════════════════════════════
# 1. DATABASE — Postgres do projeto Supabase (via Drizzle ORM)
# ══════════════════════════════════════════════════════════════════
# Painel Supabase → Project Settings → Database → Connection string
# (modo "URI", porta 5432 direta ou 6543 via pooler).
DATABASE_URL=postgresql://user:password@host:5432/postgres
# Opcional: tamanho máximo do pool de conexões do driver postgres-js.
# Sem esta variável, o padrão é 10 em desenvolvimento e 1 em produção
# (NODE_ENV=production) — pensado para ambientes serverless, onde
# cada instância deve manter poucas conexões simultâneas. Ver
# README.md, seção "Pool de conexões".
DATABASE_POOL_MAX=

# ══════════════════════════════════════════════════════════════════
# 2. SUPABASE — Auth + Storage
# ══════════════════════════════════════════════════════════════════
# Painel Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Bucket de Storage para arquivos da Inbox — precisa ser CRIADO
# manualmente no painel (Storage → New bucket), migrations não criam
# buckets. Ver README.md, seção "Dependências implícitas".
SUPABASE_STORAGE_BUCKET_INBOX=inbox-arquivos

# ══════════════════════════════════════════════════════════════════
# 3. OPENROUTER — Porta de IA (classificação da Inbox)
# ══════════════════════════════════════════════════════════════════
# openrouter.ai → Keys. Opcional: sem ela, desenvolvimento/teste usa
# um classificador fake determinístico (nunca em produção — ver
# README.md, seção "Modo fake de IA").
OPENROUTER_API_KEY=

# ══════════════════════════════════════════════════════════════════
# 3b. SCHEDULER — Vercel Cron (dispara os Jobs automaticamente)
# ══════════════════════════════════════════════════════════════════
# Qualquer string aleatória longa (ex.: `openssl rand -hex 32`).
# Configure o MESMO valor aqui e no painel da Vercel (Project Settings
# → Environment Variables) — a Vercel envia esse valor automaticamente
# como `Authorization: Bearer $CRON_SECRET` ao chamar /api/cron/[job]
# pelos agendamentos de `vercel.json`. Sem ela, a rota recusa toda
# requisição (ver README.md, seção "Jobs e Scheduler").
CRON_SECRET=

# ══════════════════════════════════════════════════════════════════
# 4. GOOGLE WORKSPACE — Calendar / Drive / Gmail
# ══════════════════════════════════════════════════════════════════
# Opcionais nesta fase — nenhuma integração nova implementada.
# Ver README.md, seção "Google Workspace", para OAuth/escopos/como
# obter estas credenciais no Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ══════════════════════════════════════════════════════════════════
# 5. PLAYWRIGHT / E2E (tests/e2e) — só para rodar `npm run test:e2e`
# ══════════════════════════════════════════════════════════════════
# Usuário real do Supabase Auth do projeto (criado manualmente no
# painel — nunca inventado pelos testes). Ver README.md, seção
# "Testes E2E".
E2E_USER_EMAIL=
E2E_USER_PASSWORD=

# ══════════════════════════════════════════════════════════════════
# 6. RUNTIME
# ══════════════════════════════════════════════════════════════════
NODE_ENV=development
